# Router 环境变量模板（复制为 .env 或直接 set 后启动）
# Router→new-api 令牌（new-api 令牌页创建，sk- 开头；此处为占位符，请替换为你自己的令牌）
NEWAPI_TOKEN=sk-你的令牌

# new-api 地址（默认本机 22222）
NEWAPI_BASE=http://127.0.0.1:22222

# Router 监听（默认 127.0.0.1:33333，仅本机）
ROUTER_HOST=127.0.0.1
ROUTER_PORT=33333
# Kimi Code 编程套餐 API Key（用于控制台展示额度；留空则不展示）
KIMI_USAGE_KEY=

# 数据库文件位置（默认 router-data/router.db，相对执行目录）
# ROUTER_DB_PATH=router-data/router.db